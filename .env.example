# OrcaRouter API Configuration
ORCA_ROUTER_API_KEY=your_orcarouter_api_key_here
ORCA_ROUTER_BASE_URL=https://api.orcarouter.ai/v1

# Slack Webhook Integration (Optional: for specification update notifications)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK_URL

# Google Drive / Local Cloud Storage Directory (Optional: defaults to ./CloudDriveSync)
GOOGLE_DRIVE_MOCK_DIR=

